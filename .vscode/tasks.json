{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Backend (NestJS)",
      "type": "shell",
      "command": "npm run start:dev",
      "options": {
        "cwd": "${workspaceFolder}/apps/backend"
      },
      "isBackground": true,
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Mobile App (Flutter)",
      "type": "shell",
      "command": "flutter run",
      "options": {
        "cwd": "${workspaceFolder}/apps/mobile_app"
      },
      "isBackground": false,
      "presentation": {
        "group": "mobile",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "Run Both Apps",
      "dependsOn": [
        "Run Backend (NestJS)",
        "Run Mobile App (Flutter)"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
